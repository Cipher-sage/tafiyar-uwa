{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tafiyar-uwa",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "CLINIC", "class_name": "Clinic" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Clinic"] }]
}
